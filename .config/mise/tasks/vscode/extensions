#!/usr/bin/env bash
#MISE description="Install VS Code extensions (no mise package manager for these)"
#MISE hide=true

# Run from the post-packages hook in dotfiles/mise.toml.

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

extensions=(
  astro-build.astro-vscode
  bmalehorn.vscode-fish
  bradlc.vscode-tailwindcss
  christian-kohler.npm-intellisense
  dart-code.dart-code
  dart-code.flutter
  dbaeumer.vscode-eslint
  doppler.doppler-vscode
  dprint.dprint
  effectful-tech.effect-vscode
  foxundermoon.shell-format
  gruntfuggly.todo-tree
  hverlin.mise-vscode
  meganrogge.template-string-converter
  oderwat.indent-rainbow
  pkief.material-icon-theme
  redhat.vscode-yaml
  tamasfe.even-better-toml
  usernamehw.errorlens
)

print_header "Installing VS Code extensions ..."
if ! command -v code > /dev/null 2>&1; then
  print_error "code CLI not found. Skipping."
  exit 0
fi

installed="$(code --list-extensions | tr '[:upper:]' '[:lower:]')"
for ext in "${extensions[@]}"; do
  grep -qix "${ext}" <<< "${installed}" && continue
  code --install-extension "${ext}"
done
