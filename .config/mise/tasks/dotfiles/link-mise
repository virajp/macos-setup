#!/usr/bin/env bash
#MISE description="Link ~/.config/mise to dotfiles/.config/mise (once per machine, before setup)"
#MISE hide=false

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Setting up '~/.config/mise' ..."
# Link `~/.config/mise` to the local repository
MISE_SRC="${MISE_PROJECT_ROOT}/dotfiles/.config/mise"
if [[ -L "${HOME}/.config/mise" ]]; then
  MISE_CURRENT_SRC="$(readlink "${HOME}/.config/mise")"
  if [[ "${MISE_CURRENT_SRC}" != "${MISE_SRC}" ]]; then
    print_info "Updating symlink to point to the correct source..."
    rm -f "${HOME}/.config/mise"
    ln -s "${MISE_SRC}" "${HOME}/.config/mise"
  fi
elif [[ -d "${HOME}/.config/mise" ]]; then
  print_info "Found existing directory at '~/.config/mise', creating symlink to '${MISE_SRC}'..."
  mv "${HOME}/.config/mise" "${HOME}/.config/mise.bak"
  ln -s "${MISE_SRC}" "${HOME}/.config/mise"
elif [[ ! -e "${HOME}/.config/mise" ]]; then
  print_info "Creating symlink to '${MISE_SRC}' at '~/.config/mise'..."
  ln -s "${MISE_SRC}" "${HOME}/.config/mise"
fi
# Fail in case the symlink was not created successfully
if [[ ! -L "${HOME}/.config/mise" ]]; then
  print_error "Failed to create symlink at '~/.config/mise'. Please check"
  exit 1
fi

print_success "Linked '~/.config/mise'"
