{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 30,
  "disableArtifact": true,
  "disableClaudeAiConnectors": true,
  "effortLevel": "high",
  "enabledPlugins": {
    "claude-design@virajp-plugins": true,
    "context7@virajp-plugins": true,
    "github-actions@virajp-plugins": true,
    "markdown@virajp-plugins": true,
    "mempalace@virajp-plugins": true,
    "mise@virajp-plugins": true,
    "typescript@virajp-plugins": true,
    "vwf@virajp-plugins": true,
    "warp@claude-code-warp": true
  },
  "env": {
    "AI_PLUGINS_USAGE_DIR": "${HOME}/.claude/usage",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_INSTALL_METHOD": "other",
    "DISABLE_AUTOUPDATER": "1"
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "repo": "warpdotdev/claude-code-warp",
        "source": "github"
      }
    },
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    },
    "virajp-plugins": {
      "source": {
        "repo": "virajp/ai-plugins",
        "source": "github"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "if [ -f '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "if [ -f '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "node ${HOME}/.claude/hooks/context-caps.js",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "if [ -f '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "if [ -f '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "if [ -f '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "if [ -f '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "if [ -f '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "if [ -f '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "command": "if [ -f '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "if [ -f '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/virajpatel/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": true,
  "inputNeededNotifEnabled": true,
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash",
      "Skill",
      "WebFetch",
      "Agent",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(* sudo *)",
      "Bash(sudo *)",
      "Bash(* su *)",
      "Bash(su *)",
      "Bash(* ssh *)",
      "Bash(ssh *)",
      "Bash(* firebase *)",
      "Bash(firebase *)",
      "Bash(* gcloud *)",
      "Bash(gcloud *)",
      "Bash(doppler *)",
      "Bash(* doppler *)"
    ]
  },
  "respectGitignore": true,
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "${HOME}/.claude/scripts/statusline",
    "padding": 0,
    "refreshInterval": 4,
    "type": "command"
  },
  "subagentStatusLine": {
    "command": "${HOME}/.claude/scripts/statusline",
    "type": "command"
  },
  "terminalProgressBarEnabled": true,
  "theme": "dark"
}
