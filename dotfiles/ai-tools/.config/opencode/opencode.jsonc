{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "command": [
        "mise",
        "x",
        "--",
        "pnpm",
        "--package=typescript",
        "--package=typescript-language-server",
        "dlx",
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".cjs",
        ".cts",
        ".js",
        ".jsx",
        ".mjs",
        ".mts",
        ".ts",
        ".tsx"
      ]
    }
  },
  "mcp": {
    "claude-design": {
      "type": "remote",
      "url": "https://api.anthropic.com/v1/design/mcp"
    },
    "context7": {
      "command": [
        "pnpm",
        "dlx",
        "@upstash/context7-mcp"
      ],
      "type": "local"
    },
    "mempalace": {
      "command": [
        "mise",
        "x",
        "--",
        "mempalace-mcp"
      ],
      "type": "local"
    }
  },
  "skills": {
    "paths": [
      "~/.config/opencode/virajp-plugins"
    ]
  }
}
