{
  "dockerfile": {
    "lineWidth": 80,
  },
  "excludes": ["**/*-lock.json", "**/*-lock.yaml", "**/*.svg", "brag-output/"],
  "markup": {
    "astro.scriptIndent": true,
    "astro.styleIndent": true,
    "component.selfClosing": true,
    "formatComments": true,
    "html.normal.selfClosing": true,
    "html.scriptIndent": true,
    "html.styleIndent": true,
    "html.void.selfClosing": true,
    "ignoreCommentDirective": "dprint-fmt-ignore",
    "mathml.selfClosing": true,
    "preferAttrsSingleLine": true,
    "scriptIndent": true,
    "styleIndent": true,
    "svelte.scriptIndent": true,
    "svelte.styleIndent": true,
    "svg.selfClosing": true,
    "vue.scriptIndent": true,
    "vue.styleIndent": true,
  },
  "newLineKind": "lf",
  // "oxc": {
  //   "arrowParentheses": "asNeeded",
  //   "bracketSameLine": false,
  //   "bracketSpacing": true,
  //   "indentStyle": "space",
  //   "indentWidth": 2,
  //   "jsxQuoteStyle": "double",
  //   "lineEnding": "lf",
  //   "lineWidth": 80,
  //   "proseWrap": "always",
  //   "quoteProperties": "asNeeded",
  //   "quoteStyle": "double",
  //   "semicolons": "always",
  //   "sortImports": {
  //     "groups": [
  //       "type-import",
  //       ["value-builtin", "value-external"],
  //       "type-internal",
  //       "value-internal",
  //       ["type-parent", "type-sibling", "type-index"],
  //       ["value-parent", "value-sibling", "value-index"],
  //       "unknown",
  //     ],
  //   },
  //   "sortPackageJson": true,
  //   "useTabs": false,
  //   "endOfLine": "lf",
  //   "embeddedLanguageFormatting": "auto",
  //   "trailingCommas": "all",
  // },
  "oxc": {
    "sortPackageJson": true,
    "sortImports": true,
    "sortTailwindcss": true,
    "jsdoc": true,
  },
  "plugins": [
    "npm:@dprint/dockerfile@0.7.0",
    "npm:dprint-plugin-markup@0.27.5",
    "npm:@dprint/oxc@0.44.0",
  ],
}
