# Git identity, included from config. A template: rendered by mise from the
# [vars] in .config/mise/conf.d/identity.toml.
[user]
	name = {{ vars.name }}
	signingkey = {{ vars.signing_key }}
	email = {{ vars.github_email }}

# Identity for GitHub
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.config/git/github.config

[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = ~/.config/git/github.config

[includeIf "gitdir:{{ vars.projects_dir }}/github.com/"]
	path = ~/.config/git/github.config

# Identity for GitLab
[includeIf "hasconfig:remote.*.url:https://gitlab.com/**"]
	path = ~/.config/git/gitlab.config

[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
	path = ~/.config/git/gitlab.config

[includeIf "gitdir:{{ vars.projects_dir }}/gitlab.com/"]
	path = ~/.config/git/gitlab.config
