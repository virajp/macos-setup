#!/usr/bin/env bash
#MISE description="Show mempalace status (runs inside the container, so it reflects the real qdrant-backed data)"

set -e
source "${HOME}/.config/mise/tasks/_scripts/_helpers"

if ! docker compose --file "${HOME}/.config/mempalace/docker-compose.yaml" ps --status running --services 2>/dev/null | grep -qx mempalace; then
  print_error "✗ mempalace container isn't running. Try: mise run mempalace:start"
  exit 1
fi

docker compose --file "${HOME}/.config/mempalace/docker-compose.yaml" exec mempalace mempalace status
