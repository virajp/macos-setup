#!/usr/bin/env bash
#MISE description="Check that docker is installed and reachable"
#MISE hide=true

set -e
source "${HOME}/.config/mise/tasks/_scripts/_helpers"

# Check if the docker command line tool even exists
if ! command -v docker &> /dev/null; then
    print_error "✗ Error: The 'docker' command-line tool is not installed."
    exit 1
fi

# Check if the Docker server/daemon is actively running and reachable
if docker info &> /dev/null; then
    print_success "✓ Docker server is up and running!"
else
    print_error "✗ Error: Cannot connect to the Docker server."
    print_wait "Please check if the daemon is running locally or if your remote DOCKER_HOST is correct.\n"
    exit 1
fi
