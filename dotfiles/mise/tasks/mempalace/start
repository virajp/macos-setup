#!/usr/bin/env bash
#MISE description="Start the mempalace stack"
#MISE depends=["mempalace:check"]
#MISE dir="~"

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

line_sep "="

print_wait "Starting qdrant (mempalace) ... "
mise x --silent -- mise bootstrap compose apply --yes --silent && print_success

print_wait "Starting mempalace hub ... "
mise x --silent -- mise bootstrap launchd apply --yes --silent && print_success
