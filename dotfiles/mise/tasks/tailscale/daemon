#!/usr/bin/env bash
#MISE description="Start tailscaled as a root brew service (prompts for sudo)"
#MISE hide=true

# Run from the post-packages hook (conf.d/macos.toml). The formula itself is
# mise's; only the daemon goes through `brew services`, because tailscaled needs
# root for the utun interface and mise has no privileged services on macOS.
# Only starts when tailscaled is not running: `sudo brew services start`
# re-bootstraps the daemon even when it is up, which drops the tunnel.

set -e
source "${HOME}/.config/mise/tasks/_scripts/_helpers"

if pgrep -x tailscaled > /dev/null; then
  print_header "tailscaled is already running."
  exit 0
fi
print_header "Starting tailscaled (root brew service) ..."
sudo brew services start tailscale
