#!/usr/bin/env bash
#MISE description="Upgrade all tools managed using Homebrew"
#MISE hide=true

set -e
source "${HOME}/.config/mise/tasks/_scripts/_helpers"

print_header "Homebrew packages ..."

# Check if brew is installed before attempting to update
if ! command -v brew >/dev/null 2>&1; then
  print_error "Homebrew is not installed. Please install Homebrew first."
  exit 1
fi

# Update Homebrew itself
print_subheader "Updating Homebrew ..."
brew update --force # --verbose

# Tailscale runs as a root service and needs special handling before the
# generic upgrade/cleanup below would otherwise fail on its root-owned keg.
mise run upgrade:tailscale

# Packages are declared in [bootstrap.packages] of the setup repo. No prune:
# the tap items installed by brew:extras are undeclared there (see the comment
# in dotfiles/mise.toml), so `packages prune` would remove them.
readonly SETUP_REPO="${HOME}/Projects/github.com/virajp/macos-setup"

print_subheader "Install/Upgrade all declared packages ..."
mise --cd "${SETUP_REPO}/dotfiles" bootstrap packages apply --yes
mise --cd "${SETUP_REPO}/dotfiles" bootstrap packages upgrade --yes

print_subheader "Upgrading all Homebrew packages ..."
brew upgrade --display-times --yes --formulae --force-bottle
# Casks installed by brew stay brew-managed (mise leaves them unchanged)
brew upgrade --display-times --yes --cask

# Remove unused dependencies
print_subheader "Removing unused Homebrew dependencies ..."
brew autoremove

# Cleanup old versions of packages
print_subheader "Cleaning up old Homebrew packages ..."
brew cleanup --prune=all
