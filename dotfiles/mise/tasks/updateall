#!/usr/bin/env bash
#MISE description="Upgrade all tools managed in the system"
#MISE depends=["global:init"]
#MISE hide=true

set -e
source "${HOME}/.config/mise/tasks/_scripts/_helpers"

# Kill keyboxd (gpg) to ensure that stale keys are refreshed
gpgconf --kill all || true

# Set global Git configuration for GPG SSH signing.
# Single-quoted so the literal ~ is written to ~/.gitconfig rather than an
# expanded absolute path: that file is a symlink into this repo, so an
# expanded $HOME would hardcode this machine's username into version control.
# git expands ~ in config path values at read time.
git config --global gpg.ssh.allowedSignersFile '~/.ssh/allowed_signers'

# Upgrade mise first to ensure we have the latest features and fixes. mise
# manages its own formula ([bootstrap.packages] in the setup repo).
print_header "Upgrading MISE ..."
mise --cd "${HOME}/Projects/github.com/virajp/macos-setup/dotfiles" bootstrap packages upgrade brew:mise --yes

# Reshim mise to ensure all tools are available
print_header "Reshimming mise ..."
mise reshim

# Run mise doctor
print_header "Running mise doctor ..."
mise doctor --quiet --silent > /dev/null

# Install & upgrade mise
print_header "Setting up MISE ..."
mise install

print_header "Upgrading mise tools ..."
mise upgrade  || true

# Pick up a freshly upgraded pitchfork: the supervisor keeps running the binary
# it started with, so without this the CLI and supervisor drift apart and newer
# config keys (e.g. the mempalace-mcp on_exit hook) are parsed by a stale
# supervisor. Before the prune below, which can delete the old install dir.
print_header "Restarting pitchfork supervisor ..."
# Not `supervisor start --force`: that kills the old supervisor and starts the
# new one at once, and the dying process unlinks the socket the new one has
# just created ("failed to connect to supervisor ... No such file or
# directory"). Stop, wait for the socket to go away, then start.
readonly PITCHFORK_SOCK="${HOME}/.local/state/pitchfork/sock/main.sock"
pitchfork supervisor stop || true
for _ in $(seq 1 50); do
  [[ -S "${PITCHFORK_SOCK}" ]] || break
  sleep 0.2
done
pitchfork supervisor start
for _ in $(seq 1 50); do
  [[ -S "${PITCHFORK_SOCK}" ]] && break
  sleep 0.2
done
# Stopping the supervisor leaves its daemons stopped; they are not re-adopted
# (boot_start only applies when the supervisor runs in boot mode). Bring them
# back now rather than leaving mempalace down for the rest of the run.
print_header "Starting global pitchfork daemons ..."
pitchfork start --global

# Prune all unused versions of tools
print_header "Pruning unused versions of tools ..."
mise prune --yes

# Upgrade Homebrew and all installed packages
mise run upgrade:brew

mise run upgrade:npm

mise run cleanupDS ~/Projects

mise run upgrade:macos:download

mise run upgrade:ai

mise run mempalace:update
mise run mempalace:restart

# Last on purpose: this prompts for sudo (pmset/nvram) and restarts Finder,
# Dock and ControlCenter, so everything above it is already done by then.
# macOS updates reset these settings, so re-applying them here is the fix.
readonly SETUP_REPO="${HOME}/Projects/github.com/virajp/macos-setup"

print_header "Applying macOS system settings ..."
if [[ -d "${SETUP_REPO}/dotfiles" ]]; then
  mise --cd "${SETUP_REPO}/dotfiles" bootstrap --only defaults,task --yes
else
  print_error "Not found: ${SETUP_REPO}"
  echo "Skipping macOS system settings."
fi

print_header "Setup complete!"
