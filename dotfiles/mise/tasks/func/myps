#!/usr/bin/env bash
#MISE description="List processes for the current user, optionally filtered"
#MISE hide=true

# Optional: with no argument every process for the user is listed, which is
# what the shell `myps` alias relies on.
#USAGE arg "[process]" default="" help="Filter processes by name"

set -e
source "${HOME}/.config/mise/tasks/_scripts/_helpers"

if [ -n "$usage_process" ]; then
  print_header "Listing processes for user $USER filtered by $usage_process ..."
else
  print_header "Listing processes for user $USER ..."
fi
# Run ps command with:
# $argv: any additional arguments passed to the function
# -u $USER: filter to show only processes owned by current user
# -o: custom output format showing:
#   - pid: process ID
#   - %cpu: CPU usage percentage
#   - %mem: memory usage percentage
#   - start: process start time
#   - time: cumulative CPU time
#   - command: full command line
# | sort -n: sort output numerically (by PID)
# ps -u $USER -o pid,%cpu,%mem,start,time,command | grep -E "PID|$usage_process" | grep -E -v "grep|mise/bin/mise|mise\/tasks" | sort -n
#
# The filter grep is applied only when a name was given: BSD grep rejects the
# empty alternation "PID|" that an unset $usage_process would produce.
if [ -n "$usage_process" ]; then
  pstree -u $USER -g 3 -l 7 | grep -E "PID|$usage_process" | grep -E -v "grep|mise\/bin\/mise|mise\/tasks"
else
  pstree -u $USER -g 3 -l 7 | grep -E -v "grep|mise\/bin\/mise|mise\/tasks"
fi
