#!/usr/bin/env zsh

##############################################################################
# macOS Setup - Install Homebrew + mise, then `mise bootstrap` the machine
##############################################################################
#
# Description:
#   Provisions a fresh laptop (or re-converges an existing one). Homebrew and
#   mise are the only things installed by hand here; everything else -
#   packages, dotfiles, macOS defaults, login shell, Touch ID - is declared in
#   dotfiles/mise.toml and applied by `mise bootstrap`.
#
# Usage:
#   ./setup
#   # or bootstrap a fresh machine directly from the public repo:
#   /bin/zsh -c "$(curl -fsSL https://raw.githubusercontent.com/virajp/macos-setup/main/setup)"
#
# Steps (Tasks):
# - First check whether `brew` is installed, if not then install it
# - Clone the repo to ~/Projects/github.com/virajp/macos-setup if it's missing
# - Check whether everything is fine with brew using `brew doctor` command
# - Install `mise` with brew if it is missing
# - Run `mise bootstrap` against dotfiles/mise.toml
#
# Note:
#   Uses absolute paths to the repo, so it can be run from anywhere — including
#   piped straight from curl on a fresh machine.
#
# Author: Viraj Patel
##############################################################################

set -euo pipefail

readonly SUCCESS_EMOJI="✅"
readonly ERROR_EMOJI="🚫"
readonly SETTING_EMOJI="⚙️"
readonly INSTALL_EMOJI="🚀"
readonly PACKAGE_EMOJI="📦"
readonly CHECK_EMOJI="🩺"

readonly REPO_URL="https://github.com/virajp/macos-setup.git"
readonly REPO_DIR="${HOME}/Projects/github.com/virajp/macos-setup"

if ! command -v brew &> /dev/null; then
  echo "${INSTALL_EMOJI} Homebrew not found. Installing..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  # The installer does not touch the current shell's PATH, so put brew on it
  # before the commands below reach for it.
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  echo "${SUCCESS_EMOJI} Homebrew is already installed."
fi

# Clone the repo if it isn't present yet (e.g. bootstrapping a fresh machine by
# piping this script straight from the public repo). Git ships with the Xcode
# Command Line Tools that the Homebrew installer above pulls in.
if [[ ! -d "${REPO_DIR}" ]]; then
  echo "${INSTALL_EMOJI} Cloning macos-setup into ${REPO_DIR}..."
  git clone "${REPO_URL}" "${REPO_DIR}"
else
  echo "${SUCCESS_EMOJI} macos-setup repo already present at ${REPO_DIR}."
fi

# Turn off homebrew analytics
echo "${SETTING_EMOJI} Turning off Homebrew analytics..."
brew analytics off

# Check Homebrew health
echo "${CHECK_EMOJI} Checking Homebrew health..."
brew doctor || true

# Install mise if it is missing; it drives the rest of the setup.
if ! command -v mise &> /dev/null; then
  echo "${INSTALL_EMOJI} mise not found. Installing..."
  brew install mise
fi

# Casks land in ~/Applications (1password is the exception, see the Brewfile).
# Only needed on a fresh machine: once the dotfiles are linked, the global mise
# [env] block sets it.
export HOMEBREW_CASK_OPTS="--appdir=${HOME}/Applications --fontdir=${HOME}/Library/Fonts"

# `mise bootstrap` does not auto-trust config the way `mise run`/`install` do,
# and the global config that whitelists ~/Projects is not linked yet.
mise trust "${REPO_DIR}/.config/mise.toml"
mise trust "${REPO_DIR}/dotfiles/mise.toml"

echo ""
echo "${PACKAGE_EMOJI} Running mise bootstrap (formulae, casks, dotfiles, macOS defaults, ...)..."
# Not run under sudo: mise elevates only where needed (/etc/pam.d, /etc/shells,
# and the pmset/nvram task), and running the whole thing as root would write
# every `defaults` key into root's preference domain instead of yours.
mise --cd "${REPO_DIR}/dotfiles" bootstrap --yes

# The global config (~/.config/mise/config.toml) only exists once the dotfiles
# phase above has linked it, and the run that linked it had already loaded its
# config. A fresh process now sees it and installs the global [tools].
echo ""
echo "${PACKAGE_EMOJI} Installing global mise tools..."
mise --cd "${REPO_DIR}/dotfiles" bootstrap --only tools --yes

echo ""
echo "${SUCCESS_EMOJI} Setup complete!"
